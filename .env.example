# ============================================================
# Variables de entorno para GTA VI Hub
# ============================================================
# Copia este archivo a `.env` en desarrollo local y configura
# los valores reales en el panel de Runable para producción.
# ============================================================

# URL pública del sitio (sin barra final).
# En desarrollo: http://localhost:3000
# En producción: https://gtavidaily.com
NEXT_PUBLIC_SITE_URL=https://gtavidaily.com

# ID de cliente de Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX).
# Déjalo con el placeholder hasta que Google apruebe el sitio.
# Una vez aprobado, sustitúyelo aquí y en el panel de Runable.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Conexión a la base de datos (Prisma).
# En desarrollo usamos SQLite local.
# En producción en Runable, sustituye por tu cadena PostgreSQL/MySQL
# o deja SQLite con la ruta que Runable te proporcione.
DATABASE_URL=file:./dev.db

# Token de verificación de Google Search Console (opcional).
# Lo encuentras en Search Console > Verificación > Etiqueta HTML.
GOOGLE_SITE_VERIFICATION=google-site-verification-token
