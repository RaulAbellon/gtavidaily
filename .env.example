# ============================================================
# Variables de entorno — GTA VI Daily
# ============================================================
# Copia este archivo a `.env.local` para desarrollo y configura
# los mismos valores en el panel de tu plataforma de despliegue.
# ============================================================

# URL pública del sitio, sin barra final. Es la ÚNICA fuente de verdad:
# de aquí salen el canonical, el sitemap, los datos estructurados y el
# fichero robots.txt.
NEXT_PUBLIC_SITE_URL=https://gtavidaily.com

# ID de cliente de Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX).
# Si no tiene el formato válido, NO se carga ningún anuncio: el bloque
# publicitario ni siquiera se renderiza.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Email de contacto que se muestra en las páginas legales y en el pie.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@gtavidaily.com

# Nombre de la identidad editorial que firma los artículos.
NEXT_PUBLIC_EDITORIAL_NAME=Redacción GTA VI Daily

# ------------------------------------------------------------
# Identificación del responsable del tratamiento
# (art. 10 LSSI-CE y art. 13 RGPD). Mientras estén vacíos, la
# página legal avisa de que faltan: son obligatorios antes de
# activar la publicidad.
# ------------------------------------------------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=

# Token de verificación de Google Search Console (opcional).
# Si está definido, se emite la etiqueta meta `google-site-verification`.
GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------
# Formulario de contacto (opcional)
# ------------------------------------------------------------
# URL a la que se envían los mensajes por POST (un webhook propio,
# Formspree, etc.). Si no se define, el endpoint /api/contacto
# responde con un error explícito indicando el email directo,
# en lugar de fingir que el mensaje se ha enviado.
CONTACT_WEBHOOK_URL=
