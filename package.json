{
  "name": "gta-vi-daily",
  "version": "2.0.0",
  "private": true,
  "description": "GTA VI Daily — sitio de noticias en español sobre Grand Theft Auto VI, con Next.js 16, rutas estáticas, consentimiento de cookies real y AdSense condicionado al consentimiento.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "content": "node scripts/content.mjs index",
    "content:check": "node scripts/content.mjs check",
    "content:fix": "node scripts/content.mjs fix",
    "content:images": "node scripts/content.mjs images",
    "content:new": "node scripts/content.mjs new",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "publish:check": "node scripts/publish.mjs --dry-run",
    "publish": "node scripts/publish.mjs",
    "deploy": "node scripts/deploy.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check": "npm run content:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5"
  }
}
